# Copy this file to .env (never commit .env to GitHub).

# Neon PostgreSQL connection string (Neon dashboard > Connection details)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign session cookies (32+ characters, e.g. openssl rand -base64 48)
SESSION_SECRET=your-random-session-secret-at-least-32-chars-long

# Quotations expire automatically after this many days (FR-12)
QUOTE_EXPIRY_DAYS=7

# Simulated booking commission rate used for reporting only (FR-23). 0.05 = 5%
COMMISSION_RATE=0.05

# Local file storage folder for development. Replace with a cloud object store in production.
STORAGE_DIR=./storage

# Maximum upload size per file in megabytes
MAX_UPLOAD_MB=5

# Used by the seed script to create the first administrator account. Change before use.
ADMIN_EMAIL=admin@prosolution.local
ADMIN_PASSWORD=ChangeMe123

# Password for the demo customer and provider accounts created by db:seed. Change before use.
DEMO_PASSWORD=Demo12345
